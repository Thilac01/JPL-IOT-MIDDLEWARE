# ==============================================================================
# JPL Library Security & IoT Middleware Environment Configuration
# ==============================================================================

# --- Application Settings ---
APP_NAME="JPL Security & IoT Middleware"
APP_VERSION="2.5.0"
ENVIRONMENT=production          # Options: production, staging, development, test
DEBUG=false                     # Set to true for auto-reload and verbose traceback
APP_HOST=0.0.0.0
APP_PORT=8000

# Security: Generate a strong 64-char key (e.g. `openssl rand -hex 32`)
SECRET_KEY=b95f517f43f0b42c15000dcfb9165a9296f2b5bd1e5a58dfc0bc12d1e29cfbcc
# Optional API Key required for privileged endpoints (/api/iot/deploy, /api/iot/exec)
# API_KEY=jpl_sec_secret_api_key_here

# Logging Configuration
LOG_LEVEL=INFO                  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/middleware.log
LOG_ROTATION_BYTES=10485760     # 10 MB
LOG_BACKUP_COUNT=5

# CORS Policy (Comma-separated list or JSON array of allowed origins)
CORS_ORIGINS=["*"]


# --- SSH Tunnel Settings ---
USE_SSH=true
SSH_HOST=137.184.15.52
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=your_ssh_password_here
# Optional SSH Private Key path (e.g. /home/appuser/.ssh/id_rsa)
# SSH_PKEY=
SSH_TIMEOUT=8
SSH_KEEPALIVE=30

# --- Read Replica Database (Koha ILS) ---
REPLICA_HOST=127.0.0.1
REPLICA_PORT=3307
REPLICA_USER=root
REPLICA_PASSWORD=your_mysql_password_here
REPLICA_DB=koha_library

# --- Security Monitor Database ---
SECURITY_DB=jpl_security_monitor

# --- MySQL Connection Pool ---
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=15
DB_POOL_RECYCLE=300
DB_CONNECT_TIMEOUT=10
DB_RECONNECT_INTERVAL=15

# --- CDC / Replication Engine ---
CDC_ENABLED=true
CDC_USER=root
CDC_PASSWORD=your_cdc_password_here
CDC_SERVER_ID=100
CDC_RESUME_STREAM=false
CDC_POLL_INTERVAL=0.05
CDC_STATE_FILE=.cdc_state.json

# --- Koha REST API ---
KOHA_API_BASE=http://137.184.15.52:1025/api/v1
KOHA_API_CLIENT_ID=your_client_id_here
KOHA_API_CLIENT_SECRET=your_client_secret_here
KOHA_API_TIMEOUT=10

# --- Email Notifications (SMTP / Brevo) ---
SMTP_ENABLED=true
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_login_email_here
SMTP_PASSWORD=your_smtp_master_key_here
SMTP_USE_TLS=true
NOTIFICATION_EMAIL=alerts@library.example.com
SMTP_RATE_LIMIT_SECONDS=5

# --- IoT Node Settings ---
IOT_HEARTBEAT_TIMEOUT_SECONDS=35
IOT_COMMAND_TIMEOUT_SECONDS=10
